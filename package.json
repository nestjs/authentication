{
  "name": "@nestjs/authentication",
  "version": "0.1.0",
  "description": "Nest - modern, fast, powerful node.js web framework (@authentication)",
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "url": "https://github.com/nestjs/authentication#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "oxlint lib/",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "vitest run",
    "test:e2e:dev": "vitest",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-angular": "21.2.3",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@nestjs/apollo": "14.0.1",
    "@nestjs/authorization": "0.1.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/drizzle": "0.0.1",
    "@nestjs/graphql": "14.0.1",
    "@nestjs/idempotency": "0.0.2",
    "@nestjs/mail": "0.0.1",
    "@nestjs/microservices": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/platform-ws": "12.1.2",
    "@nestjs/resilience": "0.0.2",
    "@nestjs/testing": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "drizzle-orm": "0.45.4",
    "graphql": "16.14.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.87.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "release-it": "21.1.1",
    "rxjs": "7.8.2",
    "supertest": "7.3.1",
    "typeorm": "1.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/microservices": {
      "optional": true
    },
    "@nestjs/websockets": {
      "optional": true
    }
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/authentication"
  }
}
